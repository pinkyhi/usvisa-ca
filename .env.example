# Start with the existing standalone behavior.
MODE=solo
USER_EMAIL=
USER_PASSWORD=
USER_CONSULATE=Vancouver
NUM_PARTICIPANTS=1
EARLIEST_ACCEPTABLE_DATE=
LATEST_ACCEPTABLE_DATE=

# A real booking POST requires an explicit false value.
TEST_MODE=true
SHOW_GUI=false
RUN_ONCE=true
PERSIST_SESSION=true

DATE_REQUEST_DELAY=180
DATE_REQUEST_CYCLE_LENGTH=0
DATE_REQUEST_CYCLE_GAP=900
RATE_LIMIT_BACKOFF_INITIAL_DELAY=4
RATE_LIMIT_BACKOFF_MAX_DELAY=4096
RATE_LIMIT_BACKOFF_MULTIPLIER=2

# Optional notifications.
GMAIL_EMAIL=
GMAIL_APPLICATION_PWD=
GMAIL_SENDER_NAME=Visa Rescheduler
RECEIVER_EMAIL=
RECEIVER_NAME=

# Optional state location. Existing checkouts default to the repository root.
# USVISA_DATA_DIR=
# Optional configuration file; defaults to the checkout .env.
# USVISA_ENV_FILE=

# Coordinated transport is planned; these fields will be enabled in that stage.
# SERVER_URL=https://visa.example.com
# NODE_TOKEN=
# NODE_MIN_DATE=
