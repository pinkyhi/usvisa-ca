# Start with the existing standalone behavior.
MODE=solo
# Compose derives the required infrastructure from MODE and EXPOSE_MODE.
EXPOSE_MODE=cloudflare_quick
COMPOSE_PROFILES=${MODE:-solo},${MODE:-solo}-${EXPOSE_MODE:-cloudflare_quick}
USER_EMAIL=
USER_PASSWORD=
USER_CONSULATE=Vancouver
NUM_PARTICIPANTS=1
EARLIEST_ACCEPTABLE_DATE=
LATEST_ACCEPTABLE_DATE=

# A real booking POST requires an explicit false value.
TEST_MODE=true
SHOW_GUI=false
PERSIST_SESSION=true

DATE_REQUEST_DELAY=180
DATE_REQUEST_CYCLE_LENGTH=0
DATE_REQUEST_CYCLE_GAP=900
RATE_LIMIT_BACKOFF_INITIAL_DELAY=4
RATE_LIMIT_BACKOFF_MAX_DELAY=4096
RATE_LIMIT_BACKOFF_MULTIPLIER=2

# Optional notifications.
GMAIL_EMAIL=
GMAIL_APPLICATION_PWD=
GMAIL_SENDER_NAME=Visa Rescheduler
RECEIVER_EMAIL=
RECEIVER_NAME=

# Optional state location. Existing checkouts default to the repository root.
# USVISA_DATA_DIR=
# Optional configuration file; defaults to the checkout .env.
# USVISA_ENV_FILE=

# Required only for MODE=coordinated. Get a token from the Coordinator portal.
# SERVER_URL=https://visa.example.com
# NODE_TOKEN=
# Optional exclusive cutoff; defaults to LATEST_ACCEPTABLE_DATE + 1 day.
# NODE_MIN_DATE=
# Automatic registration instead of copying NODE_TOKEN manually.
# PORTAL_USERNAME=admin
# PORTAL_PASSWORD=
# NODE_NAME=Main Node
# For a Docker Node connecting to a remote Coordinator, set SERVER_URL and:
# QUICK_TUNNEL_METRICS=
# Only for explicit loopback HTTP integration tests; HTTPS always verifies TLS.
# ALLOW_INSECURE_LOCALHOST=false
