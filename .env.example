# Visa portal account (not your Gmail account)
USER_EMAIL=""
USER_PASSWORD=""
USER_CONSULATE="Vancouver"
NUM_PARTICIPANTS=1

# Inclusive date range, YYYY-MM-DD
EARLIEST_ACCEPTABLE_DATE=""
LATEST_ACCEPTABLE_DATE=""
# EXCLUSION_START_DATE_1="2026-12-20"
# EXCLUSION_END_DATE_1="2027-01-05"

# True checks availability and prepares the form WITHOUT submitting a booking.
TEST_MODE=true
SHOW_GUI=true
# Stop after one browser session (useful for checking a test account).
RUN_ONCE=true

# Optional Gmail notifications. Leave these empty to disable email.
GMAIL_EMAIL=""
GMAIL_APPLICATION_PWD=""
GMAIL_SENDER_NAME="Visa Rescheduler"
RECEIVER_EMAIL=""
RECEIVER_NAME=""
